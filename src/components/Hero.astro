---
import ArrowUpRight from "@assets/arrow-up-right.svg";
import { socialLinks } from "@data/socials";
import { Image } from "astro:assets";
import Avatar from "@assets/me.avif";
---

<section class="mb-16">
  <div class="mb-6 flex gap-2">
    <Image
      src={Avatar}
      alt="It's me, João Graça"
      class="rounded-lg"
      width={90}
      height={90}
      loading="eager"
    />

    <div>
      <span class="text-zinc-300">Hey, I'm</span>
      <h1 class="text-4xl font-semibold text-zinc-100">João Graça</h1>
    </div>
  </div>

  <p class="mb-4 text-zinc-300">
    Frontend Engineer | React • TypeScript • Node.JS | 8+ years building
    scalable web applications.
    <!-- Currently working for <a
      class="text-zinc-200 underline decoration-zinc-600 underline-offset-4 sm:hover:decoration-zinc-400"
      target="_blank"
      rel="noopener noreferrer"
      aria-label={`Tekever (opens in a new tab)`}
      href="https://www.tekever.com/">Tekever</a
    > -->
  </p>

  <p class="text-zinc-300">
    Passionate about coding. In my free time, I enjoy playing video games,
    reading books, watching films, playing chess, and listening to music.
  </p>

  <ul class="flex flex-wrap mt-6 gap-x-6 gap-y-2">
    {
      socialLinks.map((link) => (
        <li>
          <a
            class="flex items-center text-zinc-300 sm:hover:text-zinc-100 underline decoration-zinc-600 underline-offset-4 sm:hover:decoration-zinc-400"
            href={link.url}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={`${link.name} (opens in a new tab)`}
          >
            {link.name}
            <ArrowUpRight />
          </a>
        </li>
      ))
    }
  </ul>
</section>
