---
import ArrowUpRight from "@assets/arrow-up-right.svg";
const { url, name } = Astro.props;
---

<a
  class="group flex items-center font-medium text-zinc-200 underline decoration-zinc-600 underline-offset-4 sm:hover:decoration-zinc-400"
  href={url}
  target="_blank"
  rel="noopener noreferrer"
  aria-label={`${name} live (opens in a new tab)`}
>
  {name}
  <ArrowUpRight class="ml-1 text-zinc-400 sm:group-hover:text-zinc-200" />
</a>
