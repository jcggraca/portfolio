---
import { projects } from "@data/projects";
import Title from "./Title.astro";
import Link from "./Link.astro";

const { featured = false } = Astro.props;
const title = featured ? "Projects" : "All Projects";
---

<section class="mb-8">
  <Title title={title} featured={featured} link="/archive" />

  <ul class="space-y-6 mb-8">
    {
      projects
        .filter((project) => !featured || project.featured)
        .map((project) => (
          <li class="space-y-1">
            <div class="w-fit flex gap-4">
              <Link url={project.url} name={project.name} />
              {!featured && project.repo && (
                <Link url={project.repo} name="Repository" />
              )}
            </div>
            <p class="text-sm leading-relaxed text-zinc-400">
              {project.description}
            </p>
          </li>
        ))
    }
  </ul>
</section>
